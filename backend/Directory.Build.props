<Project>
  <PropertyGroup>
    <UseSharedCompilation>false</UseSharedCompilation>
    <RestoreOnBuild>false</RestoreOnBuild>
    <NuGetAudit>false</NuGetAudit>
    <NoWarn>$(NoWarn);NU1900</NoWarn>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>
</Project>
